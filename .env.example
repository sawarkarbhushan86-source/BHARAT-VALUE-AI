# =====================================================================
# BHARAT VALUE AI - Environment Configuration
# =====================================================================

# Application Settings
APP_NAME="Bharat Value AI"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="127.0.0.1"

# Database Settings (SQLite for local fast development, PostgreSQL for production)
DATABASE_URL="sqlite:///./data/bharat_value_ai.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/bharat_value_ai"

# Market Data Settings
MARKET_DATA_PROVIDER="yfinance"   # "yfinance" (default, free authorized), "zerodha", "upstox"
DEFAULT_EXCHANGE="NSE"            # "NSE" or "BSE"
CACHE_TTL_SECONDS=300             # 5 minutes for quotes
CANDLE_CACHE_DAYS=30

# External API Keys (Optional - the app functions gracefully with built-in financial models without keys)
GEMINI_API_KEY=""                 # For enhanced RAG & Agentic Synthesis (Google AI Studio)
NEWS_API_KEY=""                   # For NewsAPI (optional, RSS feeds from Moneycontrol/ET are included by default)
ALPHAVANTAGE_API_KEY=""           # For secondary fundamentals validation (optional)

# NLP & RAG Settings
NLP_MODEL_TYPE="hybrid"           # "hybrid" (FinBERT-calibrated lexicon + fast embedding), "hf_finbert"
VECTOR_STORE_PATH="./data/vector_store"
EMBEDDING_DIMENSION=384

# Risk & Governance Thresholds
PROMOTER_PLEDGE_HIGH_THRESHOLD=25.0   # Percentage of promoter holding
DEBT_TO_EQUITY_MAX_THRESHOLD=2.0
INTEREST_COVERAGE_MIN_THRESHOLD=2.5
ALTMAN_Z_DISTRESS_THRESHOLD=1.8

# Backtest & Transaction Cost Settings
DEFAULT_BROKERAGE_PCT=0.0005     # 0.05%
DEFAULT_STT_PCT=0.001            # 0.1% Securities Transaction Tax (India)
DEFAULT_SLIPPAGE_PCT=0.0005      # 0.05%
